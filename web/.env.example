# Frontend configuration (Vite). VITE_* values are baked in at build time.

# Backend API base URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Dev server only (`npm run dev`): serve the MSW mock API instead of calling
# VITE_API_BASE_URL. Set to "false" to use the real backend. Ignored by
# production builds, which always call the real API.
VITE_USE_MOCKS=true
