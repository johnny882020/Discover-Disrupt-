# Backend configuration: every setting in dndlabs.core.config.Settings, with
# its default. Copy to .env (read automatically) and override as needed.
# tests/unit/core/test_config_logging.py fails if a setting is missing here.
# Frontend variables live in web/.env.example.

# --- Core ---
DNDLABS_DATABASE_URL=sqlite:///./dndlabs.db
DNDLABS_EXPORT_DIR=./exports
DNDLABS_LOG_LEVEL=INFO
DNDLABS_LOG_JSON=true
# Dev convenience: create tables without migrations. Keep false wherever
# `dnd-pipeline init-db` runs (Docker, Render).
DNDLABS_AUTO_CREATE_SCHEMA=true

# --- Auth ---
DNDLABS_ADMIN_BOOTSTRAP_SECRET=change-me-in-production
DNDLABS_FRONTEND_ORIGIN=http://localhost:5173
# Temporary, insecure shared login (bypasses per-org keys entirely). Set to
# an empty value to disable. See docs/architecture.md#auth.
DNDLABS_FREE_TIER_SHARED_PASSWORD=freetier2026

# --- PubChem connector ---
DNDLABS_PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
DNDLABS_PUBCHEM_TIMEOUT_SECONDS=30
DNDLABS_PUBCHEM_BATCH_SIZE=100
DNDLABS_PUBCHEM_MAX_RETRIES=3
DNDLABS_PUBCHEM_BACKOFF_SECONDS=0.5

# --- ChEMBL connector ---
DNDLABS_CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data
DNDLABS_CHEMBL_TIMEOUT_SECONDS=30
DNDLABS_CHEMBL_PAGE_SIZE=50
DNDLABS_CHEMBL_MAX_RETRIES=3
DNDLABS_CHEMBL_BACKOFF_SECONDS=0.5

# --- NVIDIA BioNeMo NIM (GenMol) — leave the key empty to skip enrichment ---
DNDLABS_NVIDIA_NIM_API_KEY=
DNDLABS_NVIDIA_NIM_BASE_URL=https://health.api.nvidia.com/v1/biology/nvidia/genmol
DNDLABS_NVIDIA_NIM_TIMEOUT_SECONDS=60
DNDLABS_NVIDIA_NIM_NUM_CANDIDATES=5
DNDLABS_NVIDIA_NIM_SCORING=QED
