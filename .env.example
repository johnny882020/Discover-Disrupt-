# Backend configuration: every setting in dndlabs.core.config.Settings, with
# its default. Copy to .env (read automatically) and override as needed.
# tests/unit/core/test_config_logging.py fails if a setting is missing here.
# Frontend variables live in web/.env.example.

# --- Core ---
DNDLABS_DATABASE_URL=sqlite:///./dndlabs.db
DNDLABS_LOG_LEVEL=INFO
DNDLABS_LOG_JSON=true
# Dev convenience: create tables without migrations. Keep false wherever
# `dnd-pipeline init-db` runs (Docker, Render).
DNDLABS_AUTO_CREATE_SCHEMA=true

# --- Auth ---
# Required by the API (no default; at least 24 characters). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DNDLABS_ADMIN_BOOTSTRAP_SECRET=
# Web app origin: the CORS allow-list and the base URL of invitation links.
DNDLABS_FRONTEND_ORIGIN=http://localhost:5173

# --- User accounts (docs/architecture.md#auth) ---
DNDLABS_SESSION_TTL_HOURS=12
DNDLABS_INVITATION_TTL_HOURS=72
DNDLABS_PASSWORD_RESET_TTL_HOURS=24
DNDLABS_PASSWORD_MIN_LENGTH=12

# --- Brute-force limits (fixed windows, counted in the database) ---
DNDLABS_RATE_LIMIT_WINDOW_SECONDS=900
# Failed sign-ins per window: per client IP, per email from one IP, per email from all IPs
DNDLABS_SIGNIN_LIMIT_PER_IP=20
DNDLABS_SIGNIN_LIMIT_PER_EMAIL_AND_IP=5
DNDLABS_SIGNIN_LIMIT_PER_EMAIL=50
# Failed API-key / session-token authentications per client IP per window
DNDLABS_AUTH_FAILURE_LIMIT_PER_IP=50

# --- Uploads ---
DNDLABS_UPLOAD_MAX_BYTES=26214400
DNDLABS_UPLOAD_MAX_ROWS=100000
# Largest request body accepted (must exceed the upload limit)
DNDLABS_REQUEST_MAX_BYTES=27262976
# Distinct InChIKeys, PubChem CIDs, ChEMBL IDs and names looked up per run
DNDLABS_STRUCTURE_LOOKUP_LIMIT=1000

# --- Run worker (executes queued runs inside the API process) ---
DNDLABS_WORKER_POLL_SECONDS=2
DNDLABS_WORKER_LEASE_SECONDS=120
# Unexpected worker stops (crash, kill, hang) before a run fails; clean shutdowns do not count
DNDLABS_WORKER_MAX_LOST_LEASES=3
DNDLABS_WORKER_CONCURRENCY=1
DNDLABS_WORKER_SHUTDOWN_GRACE_SECONDS=20

# --- PubChem connector ---
DNDLABS_PUBCHEM_BASE_URL=https://pubchem.ncbi.nlm.nih.gov/rest/pug
DNDLABS_PUBCHEM_TIMEOUT_SECONDS=30
DNDLABS_PUBCHEM_BATCH_SIZE=100
DNDLABS_PUBCHEM_MAX_RETRIES=3
DNDLABS_PUBCHEM_BACKOFF_SECONDS=0.5
# Pause between PubChem requests (PubChem allows 5 per second)
DNDLABS_PUBCHEM_MIN_INTERVAL_SECONDS=0.2

# --- ChEMBL connector ---
DNDLABS_CHEMBL_BASE_URL=https://www.ebi.ac.uk/chembl/api/data
DNDLABS_CHEMBL_TIMEOUT_SECONDS=30
DNDLABS_CHEMBL_PAGE_SIZE=50
DNDLABS_CHEMBL_MAX_RETRIES=3
DNDLABS_CHEMBL_BACKOFF_SECONDS=0.5

# --- NVIDIA BioNeMo NIM (GenMol) — leave the key empty to skip enrichment ---
DNDLABS_NVIDIA_NIM_API_KEY=
DNDLABS_NVIDIA_NIM_BASE_URL=https://health.api.nvidia.com/v1/biology/nvidia/genmol
DNDLABS_NVIDIA_NIM_TIMEOUT_SECONDS=60
DNDLABS_NVIDIA_NIM_NUM_CANDIDATES=5
DNDLABS_NVIDIA_NIM_SCORING=QED
